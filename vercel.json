{
  "builds": [
    {
      "src": "barbeariasite/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.11",
        "buildCommand": "python manage.py collectstatic --noinput"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "barbeariasite/wsgi.py"
    }
  ]
}

